#!/usr/bin/env bash
# Copy this file to .env.sh and fill in the real values.
# .env.sh is ignored by git and should not be shared.
# Supabase: Project Settings > API

export SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
export SUPABASE_KEY="YOUR_SERVICE_ROLE_KEY"
export SUPABASE_ANON_KEY="YOUR_ANON_PUBLIC_KEY"

# Optional: Flask session signing key
# export SECRET_KEY=""
