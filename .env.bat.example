@echo off
REM 이 파일을 .env.bat 으로 복사한 뒤 실제 값을 채워 넣으세요.
REM .env.bat 은 .gitignore에 등록되어 있어 git에 커밋되지 않습니다.
REM 키 위치: Supabase 대시보드 > Project Settings > API
set SUPABASE_URL=https://YOUR_PROJECT.supabase.co
set SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY
set SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
REM 선택: Flask 세션 서명 키 (미설정 시 서버 시작마다 무작위 생성)
REM set SECRET_KEY=
